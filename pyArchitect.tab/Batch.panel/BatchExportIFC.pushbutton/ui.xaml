<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="av"
        Title="Batch IFC Export" Width="620" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Selected models" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock x:Name="txtSelectionSummary" Text="0 models selected" Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="IFC version" Margin="0,0,0,2" />
                    <ComboBox x:Name="cmbVersion" Margin="0,0,0,8" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Site placement" Margin="0,0,0,2" />
                    <ComboBox x:Name="cmbSitePlacement" Margin="0,0,0,8" SelectedIndex="0">
                        <ComboBoxItem Content="Shared Coordinates" />
                        <ComboBoxItem Content="Survey Point" />
                        <ComboBoxItem Content="Project Base Point" />
                        <ComboBoxItem Content="Internal Origin" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Navisworks view name (used when a model's list row has no views)" Margin="0,0,0,2" />
            <TextBox x:Name="txtDefaultView" Margin="0,0,0,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Model content" FontWeight="Bold" Margin="0,0,0,4" />
                <CheckBox x:Name="chkSplitWalls" Content="Split walls and columns by level" Margin="0,3" />
                <CheckBox x:Name="chkSteel" Content="Include steel elements" Margin="0,3" />
                <CheckBox x:Name="chk2D" Content="Export 2D plan view elements" Margin="0,3" />
                <CheckBox x:Name="chkParts" Content="Export parts as building elements" Margin="0,3" />
                <CheckBox x:Name="chkSolidRep" Content="Export solid model representation" Margin="0,3" />
                <CheckBox x:Name="chkFamilyTypeRef" Content="Use family and type name for reference" Margin="0,3" />
                <CheckBox x:Name="chkSiteElevation" Content="Include site elevation in place placement" Margin="0,3" />
                <CheckBox x:Name="chkStoreGuid" Content="Store IFC GUID in element (modifies model)" Margin="0,3" />
                <CheckBox x:Name="chkOnlyView" Content="Export only elements visible in the view" Margin="0,3" />
                <CheckBox x:Name="chkRooms" Content="Export rooms/spaces" Margin="0,3" />

                <TextBlock Text="Linked models" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="chkSkipLinkLoad" Content="Open without loading Revit links (uses temporary copies)" Margin="0,3" />
                <CheckBox x:Name="chkLinksMerged" Content="Include linked models in the same IFC file" Margin="0,3" />
                <CheckBox x:Name="chkLinksSeparate" Content="Also export each linked model to its own IFC file" Margin="0,3" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Property sets / quantities" FontWeight="Bold" Margin="0,0,0,4" />
                <CheckBox x:Name="chkRevitPsets" Content="Export Revit property sets" Margin="0,3" />
                <CheckBox x:Name="chkCommonPsets" Content="Export IFC common property sets" Margin="0,3" />
                <CheckBox x:Name="chkBaseQuantities" Content="Export base quantities" Margin="0,3" />
                <CheckBox x:Name="chkSchedulesAsPsets" Content="Export schedules as property sets" Margin="0,3" />
                <CheckBox x:Name="chkUserPsets" Content="Export user-defined psets (per-model mapping file from list)" Margin="0,3" />

                <TextBlock Text="After export" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="chkSaveAfter" Content="Save / synchronize model after export" Margin="0,3" />
                <CheckBox x:Name="chkOpenFolders" Content="Open export folders when done" Margin="0,3" IsChecked="True" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" Click="on_cancel" />
            <Button Content="Run Export" Width="120" Height="28" Click="on_run" />
        </StackPanel>
    </Grid>
</Window>
